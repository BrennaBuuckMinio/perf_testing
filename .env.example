# S3 Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=tpcds
S3_FOLDER_NAME=sample_1Tb

# Iceberg Configuration
ICEBERG_BUCKET_NAME=iceberg
ICEBERG_FOLDER_NAME=sample_1Tb

# Dremio Configuration
DREMIO_USERNAME=                    # Dremio username
DREMIO_PASSWORD=                    # Dremio password
DREMIO_URL=http://localhost:9047    # Dremio REST API URL

# Dremio JDBC Configuration (for JMeter benchmark-kit)
DREMIO_JDBC_HOST=localhost          # Dremio JDBC hostname
DREMIO_JDBC_PORT=31010              # Dremio JDBC port

# Dremio Source Names
DREMIO_SOURCE_NAME=tpcds            # S3 source name in Dremio
NESSIE_SOURCE_NAME=nessie           # Nessie catalog source name in Dremio

# Benchmark Results Storage
BENCHMARK_BUCKET=benchmark-results  # S3 bucket for uploading JMeter results
